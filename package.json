{
  "name": "quicknotes",
  "version": "1.0.0",
  "private": true,
  "description": "Manifest V3 Chrome extension for highlights and sticky notes on any web page. Local-only: no network, no analytics.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/icons.mjs",
    "zip": "npm run build && node scripts/zip.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "demo": "node scripts/demo-server.mjs"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.0",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "playwright": "1.57.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "sharp": "0.35.4",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
